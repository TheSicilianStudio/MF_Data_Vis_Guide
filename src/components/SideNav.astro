    <div class="nav-swatch" style="background:#FF4F00;"></div>
  </div>
</nav>

<script>
  // Intersection Observer — highlight active section in nav
  const links = document.querySelectorAll('.nav-link');
  const sections = document.querySelectorAll('section[id]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id.replace('section-', '');
        links.forEach(l => l.classList.remove('active'));
        const active = document.querySelector(`.nav-link[data-section="${id}"]`);
        if (active) active.classList.add('active');
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  sections.forEach(s => observer.observe(s));
</script>

<style>
  #sidenav {
    position: fixed;
    top: 0;
    left: 0;
    width: 200px;
    height: 100vh;
    background: var(--ink);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    z-index: 100;
    scrollbar-width: thin;
    scrollbar-color: var(--brand-yellow) var(--ink);
  }
  .nav-header {
    padding: 1.25rem 1rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .nav-brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--brand-yellow);
    letter-spacing: 0.05em;
  }
  .nav-version {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: rgba(255,255,255,0.3);
  }
  .nav-list {
    list-style: none;
    padding: 0.5rem 0;
    flex: 1;
  }
  .nav-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.42rem 1rem;
    text-decoration: none;
    transition: background 0.15s;
  }
  .nav-link:hover {
    background: rgba(255,255,255,0.06);
  }
  .nav-link.active {
    background: rgba(255,205,0,0.12);
    border-left: 2px solid var(--brand-yellow);
    padding-left: calc(1rem - 2px);
  }
  .nav-link.active .nav-num {
    color: var(--brand-yellow);
  }
  .nav-link.active .nav-label {
    color: var(--white);
  }
  .nav-num {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
    width: 22px;
  }
  .nav-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.3;
  }
  .nav-footer {
    padding: 1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .nav-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }
</style>
