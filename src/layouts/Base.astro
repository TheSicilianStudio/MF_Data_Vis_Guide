---
// Base layout — HTML shell, fonts, global styles
interface Props {
  title?: string;
}
const { title = "Data Visualisation Style Guide" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Data Visualisation Style Guide — colour, typography, chart patterns and accessibility standards." />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  /* Layout shell — sidebar + content */
  body {
    display: flex;
  }
  #sidenav {
    flex-shrink: 0;
  }
  #content {
    margin-left: 200px;
    flex: 1;
    min-width: 0;
  }
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4rem 6rem;
  }

  /* ── Responsive: collapse nav on small screens ── */
  @media (max-width: 900px) {
    #sidenav {
      display: none;
    }
    #content {
      margin-left: 0;
    }
    main {
      padding: 0 1.5rem 4rem;
    }
  }
</style>
