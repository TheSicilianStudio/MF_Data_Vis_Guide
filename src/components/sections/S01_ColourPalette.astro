---
---

<section id="section-01">
  <div class="section-header">
    <span class="section-number">01</span>
    <h2>Colour Palette</h2>
  </div>

  <p class="section-intro">The brand colours serve as the foundation. They are complemented by a restrained set of data-specific colours and neutrals. Never introduce ad-hoc colours — always use this palette.</p>

  <p class="label-caps mb-sm">Brand Primaries</p>
  <div class="palette-grid mb-lg">

    <div class="swatch">
      <div class="swatch-color bg-yellow">
        <span class="swatch-label-top" style="background:rgba(0,0,0,0.15); color:#1E1E1E;">Primary</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Brand Yellow</div>
        <div class="swatch-hex">#FFCD00</div>
        <div class="swatch-role">Primary highlight, key data series, alert states. Use dark text on this colour.</div>
      </div>
    </div>

    <div class="swatch">
      <div class="swatch-color bg-orange">
        <span class="swatch-label-top swatch-overlay--dark">Primary</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Brand Orange</div>
        <div class="swatch-hex">#FF4F00</div>
        <div class="swatch-role">Secondary data series, accent, CTA. Use white or very dark text only.</div>
      </div>
    </div>

    

    

    

    

  </div>

  <p class="label-caps mb-sm">Neutrals</p>
  <div class="palette-grid mb-lg">
    <div class="swatch">
      <div class="swatch-color bg-ink"><span class="swatch-label-top swatch-overlay--white-soft">Neutral</span></div>
      <div class="swatch-info"><div class="swatch-name">Ink</div><div class="swatch-hex">#1E1E1E</div><div class="swatch-role">Axes, labels, titles, gridlines.</div></div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#6B6B6B;"><span class="swatch-label-top swatch-overlay--white-soft">Neutral</span></div>
      <div class="swatch-info"><div class="swatch-name">Ink Soft</div><div class="swatch-hex">#6B6B6B</div><div class="swatch-role">Secondary labels, annotations, axis ticks.</div></div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#E0E0E0;"><span class="swatch-label-top swatch-overlay--light">Neutral</span></div>
      <div class="swatch-info"><div class="swatch-name">Rule</div><div class="swatch-hex">#E0E0E0</div><div class="swatch-role">Gridlines, dividers, borders.</div></div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#FEFEFE;"><span class="swatch-label-top" style="background:rgba(0,0,0,0.06); color:#1E1E1E;">Neutral</span></div>
      <div class="swatch-info"><div class="swatch-name">Surface</div><div class="swatch-hex">#FEFEFE</div><div class="swatch-role">Chart backgrounds, table rows.</div></div>
    </div>
  </div>

  <p class="label-caps mb-sm">Brand Yellow — Tints</p>
  <div class="palette-grid mb-lg">
    <div class="swatch">
      <div class="swatch-color" style="background:#FEF2BE; border:1px solid #E8E0A0;">
        <span class="swatch-label-top swatch-overlay--lightest">25%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Yellow 25%</div>
        <div class="swatch-hex">#FEF2BE</div>
        <div class="swatch-role">Background wash, subtle row highlights. <strong class="text-fail">Not for data fills — insufficient contrast on surface.</strong></div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#FEE67F;">
        <span class="swatch-label-top" style="background:rgba(0,0,0,0.09); color:#1E1E1E;">50%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Yellow 50%</div>
        <div class="swatch-hex">#FEE67F</div>
        <div class="swatch-role">Area chart fills, heatmap mid-range. Use dark text labels only. Not a standalone data colour.</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#FFD940;">
        <span class="swatch-label-top swatch-overlay--dim">75%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Yellow 75%</div>
        <div class="swatch-hex">#FFD940</div>
        <div class="swatch-role">Sequential scales, secondary bar fills. Readable with dark (#1E1E1E) labels. Pair with 100% for emphasis.</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color bg-yellow">
        <span class="swatch-label-top swatch-overlay--mid">100%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Yellow 100%</div>
        <div class="swatch-hex">#FFCD00</div>
        <div class="swatch-role">Full brand. Primary data series, peak values, key highlights.</div>
      </div>
    </div>
  </div>

  <p class="label-caps mb-sm">Brand Orange — Tints</p>
  <div class="palette-grid mb-lg">
    <div class="swatch">
      <div class="swatch-color" style="background:#FED2BE; border:1px solid #E8C0A8;">
        <span class="swatch-label-top swatch-overlay--lightest">25%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Orange 25%</div>
        <div class="swatch-hex">#FED2BE</div>
        <div class="swatch-role">Background wash only. <strong class="text-fail">Not for data fills — fails contrast on surface.</strong></div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#FEA67F;">
        <span class="swatch-label-top swatch-overlay--dim">50%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Orange 50%</div>
        <div class="swatch-hex">#FEA67F</div>
        <div class="swatch-role">Area fills, heatmap mid-range. Always pair with dark text. Avoid as a standalone series colour.</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color" style="background:#FF7B40;">
        <span class="swatch-label-top swatch-overlay--mid">75%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Orange 75%</div>
        <div class="swatch-hex">#FF7B40</div>
        <div class="swatch-role">Sequential scales, intermediate steps. Approaching usable contrast — test at intended size before use.</div>
      </div>
    </div>
    <div class="swatch">
      <div class="swatch-color bg-orange">
        <span class="swatch-label-top" style="background:rgba(0,0,0,0.15); color:#fff;">100%</span>
      </div>
      <div class="swatch-info">
        <div class="swatch-name">Orange 100%</div>
        <div class="swatch-hex">#FF4F00</div>
        <div class="swatch-role">Full brand. Accent, target lines, highlights, secondary series.</div>
      </div>
    </div>
  </div>

</section>
