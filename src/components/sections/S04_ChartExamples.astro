                    <circle cx="80"  cy="140" r="3" fill="#FFA97A" stroke="#fff" stroke-width="1.2"/>
                    <circle cx="350" cy="95"  r="3" fill="#FFA97A" stroke="#fff" stroke-width="1.2"/>
                    <circle cx="620" cy="55"  r="3" fill="#FFA97A" stroke="#fff" stroke-width="1.2"/>
                    <!-- Dots — Teal -->
                    <circle cx="80"  cy="155" r="3" fill="#D79EED" stroke="#fff" stroke-width="1.2"/>
                    <circle cx="350" cy="133" r="3" fill="#D79EED" stroke="#fff" stroke-width="1.2"/>
                    <circle cx="620" cy="110" r="3" fill="#D79EED" stroke="#fff" stroke-width="1.2"/>
                  </svg>
                  <div class="legend-examples">
                    <div class="legend-item"><div class="legend-dash" style="background:#FFCD00; height:2.5px;"></div><span>Product A (primary)</span></div>
                    <div class="legend-item"><div class="legend-dash legend-dash--orange"></div><span>Product B</span></div>
                    <div class="legend-item"><div class="legend-dash" style="background:#D79EED; height:2px;"></div><span>Product C</span></div>
                  </div>
                  <div class="chart-note">↗ Full brand colour on strokes; light tints (#FFF5CC, #FFE6D9) for area fills. Layering order keeps the primary series (Yellow) visually dominant.</div>
                </div>
      <div class="chart-card">
                  <div class="chart-title">Waterfall Chart — P&amp;L Bridge</div>
                  <div class="chart-subtitle">Brand Yellow for positive contributions; Brand Orange for negative; Ink for the total bar.</div>
                  <svg width="100%" viewBox="0 0 680 230" xmlns="http://www.w3.org/2000/svg">
                    <!-- Grid -->
                    <line x1="50" y1="20" x2="50" y2="185" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="50" y1="185" x2="660" y2="185" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="50" y1="145" x2="660" y2="145" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="50" y1="105" x2="660" y2="105" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="50" y1="65"  x2="660" y2="65"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <!-- Y labels -->
                    <text x="44" y="188" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">0</text>
                    <text x="44" y="148" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">1M</text>
