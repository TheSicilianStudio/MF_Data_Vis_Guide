<section id="section-06">
  <div class="section-header">
    <span class="section-number">06</span>
    <h2>Typography in Charts</h2>
  </div>

  <div class="type-row">
    <div class="type-label">Chart Title</div>
    <div style="font-family:var(--font-display); font-weight:500; font-size:1.1rem; color:var(--ink);">Revenue by Region — Q2 2025</div>
  </div>
  <div class="type-row">
    <div class="type-label">Chart Subtitle</div>
    <div style="font-family:var(--font-body); font-weight:300; font-size:0.8rem; color:var(--ink-soft);">All figures in GBP millions · Source: Finance BI · Updated weekly</div>
  </div>
  <div class="type-row">
    <div class="type-label">Axis Labels</div>
    <div style="font-family:var(--font-mono); font-size:0.72rem; color:var(--ink-soft);">Jan · Feb · Mar · Apr · May · Jun</div>
  </div>
  <div class="type-row">
    <div class="type-label">Data Labels</div>
    <div style="font-family:var(--font-mono); font-weight:500; font-size:0.75rem; color:var(--ink);">£2.4M &nbsp; £3.1M &nbsp; £2.8M</div>
  </div>
  <div class="type-row">
    <div class="type-label">Annotations</div>
    <div style="font-family:var(--font-body); font-size:0.75rem; color:var(--brand-orange); font-weight:600;">▲ Record High — April 2025</div>
  </div>
  <div class="type-row">
    <div class="type-label">Legend</div>
    <div class="row-lg">
      <span class="row-xs legend-text"><span style="display:inline-block; width:12px; height:12px; background:#FFCD00; border-radius:2px;"></span>Product A</span>
      <span class="row-xs legend-text"><span style="display:inline-block; width:12px; height:12px; background:#00897B; border-radius:2px;"></span>Product B</span>
    </div>
  </div>

  <div class="card-sm mt-md">
    <p class="text-body-sm">
      <strong class="text-dark">Font stack:</strong> Titles and display use <code class="code-inline">Public Sans 700–800</code> (bold, condensed-neutral). Body copy and subtitles use <code class="code-inline">Public Sans 300–500</code>. All numeric values and axis labels use <code class="code-inline">DM Mono</code> for tabular alignment. Loading a single variable typeface (Public Sans) reduces font requests from 3 to 2. Minimum font size in any chart: <strong>10px</strong> at 100% zoom.
    </p>
  </div>
</section>
