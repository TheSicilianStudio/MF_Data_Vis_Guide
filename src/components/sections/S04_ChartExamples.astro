                    <polyline points="80,115 170,100 260,82 350,65 440,52 530,44 620,32" fill="none" stroke="#FFCD00" stroke-width="2.5" stroke-linejoin="round"/>
                    <!-- Dots — Yellow -->
                    <circle cx="80"  cy="115" r="3.5" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.2"/>
                    <circle cx="350" cy="65"  r="3.5" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.2"/>
                    <circle cx="620" cy="32"  r="3.5" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.2"/>
