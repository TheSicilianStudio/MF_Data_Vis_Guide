<section id="section-04">
  <div class="section-header">
    <span class="section-number">04</span>
    <h2>Chart Examples</h2>
  </div>

  <div class="charts-grid">

    <div class="chart-row">
      <div class="chart-card">
                  <div class="chart-title">Bar Chart — Single Series</div>
                  <div class="chart-subtitle">Brand Yellow as the primary series; Orange highlights the peak.</div>
                  <svg width="100%" viewBox="0 0 340 200" xmlns="http://www.w3.org/2000/svg">
                    <!-- Grid -->
                    <line x1="40" y1="20" x2="40" y2="170" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="40" y1="170" x2="330" y2="170" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="40" y1="130" x2="330" y2="130" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="40" y1="90"  x2="330" y2="90"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="40" y1="50"  x2="330" y2="50"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <!-- Y Labels -->
                    <text x="35" y="173" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">0</text>
                    <text x="35" y="133" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">25</text>
                    <text x="35" y="93"  font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">50</text>
                    <text x="35" y="53"  font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">75</text>
                    <!-- Bars -->
                    <rect x="55"  y="110" width="30" height="60" fill="#FFCD00" rx="2" class="bar-animate" style="animation-delay:0s"/>
                    <rect x="100" y="90"  width="30" height="80" fill="#FFCD00" rx="2" class="bar-animate" style="animation-delay:0.08s"/>
                    <rect x="145" y="70"  width="30" height="100" fill="#FFCD00" rx="2" class="bar-animate" style="animation-delay:0.16s"/>
                    <rect x="190" y="30"  width="30" height="140" fill="#F7BB49" rx="2" class="bar-animate" style="animation-delay:0.24s"/>
                    <rect x="235" y="60"  width="30" height="110" fill="#FFCD00" rx="2" class="bar-animate" style="animation-delay:0.32s"/>
                    <rect x="280" y="80"  width="30" height="90"  fill="#FFCD00" rx="2" class="bar-animate" style="animation-delay:0.4s"/>
                    <!-- Peak label -->
                    <text x="205" y="25" font-size="8" fill="#CC9500" text-anchor="middle" font-weight="600" font-family="Public Sans,sans-serif">Peak ▲</text>
                    <!-- X Labels -->
                    <text x="70"  y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Jan</text>
                    <text x="115" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Feb</text>
                    <text x="160" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Mar</text>
                    <text x="205" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Apr</text>
                    <text x="250" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">May</text>
                    <text x="295" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Jun</text>
                  </svg>
                  <div class="legend-examples">
                    <div class="legend-item"><div class="legend-rect bg-yellow"></div><span>Monthly Revenue</span></div>
                    <div class="legend-item"><div class="legend-rect bg-orange"></div><span>Peak Month</span></div>
                  </div>
                  <div class="chart-note">↗ Brand Yellow for all bars; Orange flags the outlier/peak. Dark text labels atop yellow bars.</div>
                </div>
      <div class="chart-card">
                  <div class="chart-title">Line Chart — Two Series</div>
                  <div class="chart-subtitle">Brand Yellow as primary; extended palette for second series.</div>
                  <svg width="100%" viewBox="0 0 340 200" xmlns="http://www.w3.org/2000/svg">
                    <!-- Grid -->
                    <line x1="40" y1="20" x2="40" y2="170" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="40" y1="170" x2="330" y2="170" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="40" y1="130" x2="330" y2="130" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="40" y1="90"  x2="330" y2="90"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="40" y1="50"  x2="330" y2="50"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <!-- Y Labels -->
                    <text x="35" y="173" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">0</text>
                    <text x="35" y="133" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">25</text>
                    <text x="35" y="93"  font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">50</text>
                    <text x="35" y="53"  font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">75</text>
                    <!-- Area Yellow -->
                    <path d="M55,140 L110,120 L165,90 L220,60 L275,80 L320,50 L320,170 L55,170 Z" fill="#FFF5CC" opacity="0.8"/>
                    <!-- Area Teal -->
                    <path d="M55,150 L110,140 L165,125 L220,110 L275,95 L320,85 L320,170 L55,170 Z" fill="#F3E6FB" opacity="0.8"/>
                    <!-- Line Yellow -->
                    <polyline points="55,140 110,120 165,90 220,60 275,80 320,50" fill="none" stroke="#FFCD00" stroke-width="2.5" stroke-linejoin="round"/>
                    <!-- Line Teal -->
                    <polyline points="55,150 110,140 165,125 220,110 275,95 320,85" fill="none" stroke="#D79EED" stroke-width="2.5" stroke-linejoin="round" stroke-dasharray="6,3"/>
                    <!-- Dots Yellow -->
                    <circle cx="55" cy="140" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <circle cx="110" cy="120" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <circle cx="165" cy="90" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <circle cx="220" cy="60" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <circle cx="275" cy="80" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <circle cx="320" cy="50" r="4" fill="#FFCD00" stroke="#1E1E1E" stroke-width="1.5"/>
                    <!-- Dots Teal -->
                    <circle cx="55" cy="150" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <circle cx="110" cy="140" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <circle cx="165" cy="125" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <circle cx="220" cy="110" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <circle cx="275" cy="95" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <circle cx="320" cy="85" r="3.5" fill="#D79EED" stroke="#fff" stroke-width="1.5"/>
                    <!-- X Labels -->
                    <text x="55"  y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q1</text>
                    <text x="110" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q2</text>
                    <text x="165" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q3</text>
                    <text x="220" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q4</text>
                    <text x="275" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q5</text>
                    <text x="320" y="183" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Q6</text>
                  </svg>
                  <div class="legend-examples">
                    <div class="legend-item"><div class="legend-dash bg-yellow"></div><span>Product A</span></div>
                    <div class="legend-item"><div class="legend-dash" style="background:#D79EED; border-top:2px dashed #00897B; background:none; height:0;"></div><span>Product B</span></div>
                  </div>
                  <div class="chart-note">↗ Solid line for primary (Yellow), dashed for secondary (Teal). Distinct markers for colour-blind safety.</div>
                </div>
    </div>

    <div class="chart-row">
      <div class="chart-card">
                  <div class="chart-title">Donut Chart — Composition</div>
                  <div class="chart-subtitle">Brand colours lead; neutrals fill remaining segments.</div>
                  <svg width="100%" viewBox="0 0 340 220" xmlns="http://www.w3.org/2000/svg">
                    <!-- Donut: cx=140, cy=110, R=75, r=45. Segments start at -90deg (top), sweep clockwise. -->
                    <!-- Yellow: 35% (-90deg → 36deg) -->
                    <path d="M140.000,35.000 A75,75 0 0,1 200.676,154.084 L176.406,136.450 A45,45 0 0,0 140.000,65.000 Z" fill="#FFCD00"/>
                    <!-- Orange: 22% (36deg → 115.2deg) -->
                    <path d="M200.676,154.084 A75,75 0 0,1 108.067,177.862 L120.840,150.717 A45,45 0 0,0 176.406,136.450 Z" fill="#FFA97A"/>
                    <!-- Teal: 18% (115.2deg → 180deg) -->
                    <path d="M108.067,177.862 A75,75 0 0,1 65.000,110.000 L95.000,110.000 A45,45 0 0,0 120.840,150.717 Z" fill="#D79EED"/>
                    <!-- Slate: 15% (180deg → 234deg) -->
                    <path d="M65.000,110.000 A75,75 0 0,1 95.916,49.324 L113.550,73.594 A45,45 0 0,0 95.000,110.000 Z" fill="#ACA1A1"/>
                    <!-- Blue: 10% (234deg → 270deg) -->
                    <path d="M95.916,49.324 A75,75 0 0,1 140.000,35.000 L140.000,65.000 A45,45 0 0,0 113.550,73.594 Z" fill="#F5A1E7"/>
                    <!-- Centre hole -->
                    <circle cx="140" cy="110" r="44" fill="white"/>
                    <text x="140" y="105" font-size="20" font-family="Public Sans,sans-serif" font-weight="800" fill="#1E1E1E" text-anchor="middle">35%</text>
                    <text x="140" y="119" font-size="8" font-family="Public Sans,sans-serif" fill="#6B6B6B" text-anchor="middle">Brand Yellow</text>
                    <!-- Legend -->
                    <rect x="232" y="50"  width="10" height="10" rx="2" fill="#FFCD00"/>
                    <text x="247" y="59" font-size="9" fill="#3D3D3D" font-family="Public Sans,sans-serif">Category A <tspan font-family="DM Mono,monospace" font-size="8" fill="#6B6B6B">35%</tspan></text>
                    <rect x="232" y="68"  width="10" height="10" rx="2" fill="#FFA97A"/>
                    <text x="247" y="77" font-size="9" fill="#3D3D3D" font-family="Public Sans,sans-serif">Category B <tspan font-family="DM Mono,monospace" font-size="8" fill="#6B6B6B">22%</tspan></text>
                    <rect x="232" y="86"  width="10" height="10" rx="2" fill="#D79EED"/>
                    <text x="247" y="95" font-size="9" fill="#3D3D3D" font-family="Public Sans,sans-serif">Category C <tspan font-family="DM Mono,monospace" font-size="8" fill="#6B6B6B">18%</tspan></text>
                    <rect x="232" y="104" width="10" height="10" rx="2" fill="#ACA1A1"/>
                    <text x="247" y="113" font-size="9" fill="#3D3D3D" font-family="Public Sans,sans-serif">Category D <tspan font-family="DM Mono,monospace" font-size="8" fill="#6B6B6B">15%</tspan></text>
                    <rect x="232" y="122" width="10" height="10" rx="2" fill="#F5A1E7"/>
                    <text x="247" y="131" font-size="9" fill="#3D3D3D" font-family="Public Sans,sans-serif">Category E <tspan font-family="DM Mono,monospace" font-size="8" fill="#6B6B6B">10%</tspan></text>
                  </svg>
                  <div class="chart-note">↗ Yellow leads as the largest/most important slice. Orange second. Extended palette for remaining segments.</div>
                </div>
      <div class="chart-card">
                  <div class="chart-title">Horizontal Stacked Bar</div>
                  <div class="chart-subtitle">Brand Yellow and extended palette; Orange marks the target.</div>
                  <svg width="100%" viewBox="0 0 340 200" xmlns="http://www.w3.org/2000/svg">
                    <!-- Axis -->
                    <line x1="80" y1="20" x2="80" y2="175" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="80" y1="175" x2="330" y2="175" stroke="#E0E0E0" stroke-width="1"/>
                    <!-- Gridlines -->
                    <line x1="143" y1="20" x2="143" y2="175" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="206" y1="20" x2="206" y2="175" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="268" y1="20" x2="268" y2="175" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <!-- X axis labels -->
                    <text x="80"  y="185" font-size="7" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">0</text>
                    <text x="143" y="185" font-size="7" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">25</text>
                    <text x="206" y="185" font-size="7" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">50</text>
                    <text x="268" y="185" font-size="7" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">75</text>
                    <!-- Row 1: London -->
                    <text x="76" y="50" font-size="9" fill="#3D3D3D" text-anchor="end" font-family="Public Sans,sans-serif">London</text>
                    <rect x="81" y="35" width="88" height="20" fill="#FFCD00" rx="2"/>
                    <rect x="169" y="35" width="56" height="20" fill="#D79EED" rx="2"/>
                    <rect x="225" y="35" width="38" height="20" fill="#ACA1A1" rx="2"/>
                    <!-- Row 2: NYC -->
                    <text x="76" y="90" font-size="9" fill="#3D3D3D" text-anchor="end" font-family="Public Sans,sans-serif">New York</text>
                    <rect x="81" y="75" width="100" height="20" fill="#FFCD00" rx="2"/>
                    <rect x="181" y="75" width="44" height="20" fill="#D79EED" rx="2"/>
                    <rect x="225" y="75" width="50" height="20" fill="#ACA1A1" rx="2"/>
                    <!-- Row 3: Tokyo -->
                    <text x="76" y="130" font-size="9" fill="#3D3D3D" text-anchor="end" font-family="Public Sans,sans-serif">Tokyo</text>
                    <rect x="81" y="115" width="113" height="20" fill="#FFCD00" rx="2"/>
                    <rect x="194" y="115" width="50" height="20" fill="#D79EED" rx="2"/>
                    <rect x="244" y="115" width="25" height="20" fill="#ACA1A1" rx="2"/>
                    <!-- Target line -->
                    <line x1="244" y1="20" x2="244" y2="165" stroke="#F7BB49" stroke-width="1.5" stroke-dasharray="5,3"/>
                    <text x="246" y="28" font-size="7" fill="#CC9500" font-family="Public Sans,sans-serif" font-weight="600">Target</text>
                  </svg>
                  <div class="legend-examples">
                    <div class="legend-item"><div class="legend-rect bg-yellow"></div><span>Revenue</span></div>
                    <div class="legend-item"><div class="legend-rect" style="background:#D79EED;"></div><span>Growth</span></div>
                    <div class="legend-item"><div class="legend-rect" style="background:#ACA1A1;"></div><span>Other</span></div>
                    <div class="legend-item"><div class="legend-dash legend-dash--orange"></div><span>Target</span></div>
                  </div>
                  <div class="chart-note">↗ Orange target line stands out without competing with Yellow's data role.</div>
                </div>
    </div>

    

    <div class="chart-row">
      <div class="chart-card">
                  <div class="chart-title">Area Chart — Multi-Series</div>
                  <div class="chart-subtitle">Stacked area using tints for fills; full brand colours on strokes to preserve series identity.</div>
                  <svg width="100%" viewBox="0 0 680 220" xmlns="http://www.w3.org/2000/svg">
                    <!-- Grid -->
                    <line x1="50" y1="20" x2="50" y2="180" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="50" y1="180" x2="660" y2="180" stroke="#E0E0E0" stroke-width="1"/>
                    <line x1="50" y1="140" x2="660" y2="140" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="50" y1="100" x2="660" y2="100" stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <line x1="50" y1="60"  x2="660" y2="60"  stroke="#E0E0E0" stroke-width="0.5" stroke-dasharray="3,3"/>
                    <!-- Y labels -->
                    <text x="44" y="183" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">0</text>
                    <text x="44" y="143" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">25</text>
                    <text x="44" y="103" font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">50</text>
                    <text x="44" y="63"  font-size="8" fill="#6B6B6B" text-anchor="end" font-family="DM Mono,monospace">75</text>
                    <!-- X labels -->
                    <text x="80"  y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Jan</text>
                    <text x="170" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Feb</text>
                    <text x="260" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Mar</text>
                    <text x="350" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Apr</text>
                    <text x="440" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">May</text>
                    <text x="530" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Jun</text>
                    <text x="620" y="196" font-size="8" fill="#6B6B6B" text-anchor="middle" font-family="DM Mono,monospace">Jul</text>
                    <!-- Teal area (Series C — bottom layer) -->
                    <path d="M80,155 L170,148 L260,140 L350,133 L440,125 L530,118 L620,110 L620,180 L80,180 Z" fill="#F3E6FB" opacity="0.9"/>
                    <polyline points="80,155 170,148 260,140 350,133 440,125 530,118 620,110" fill="none" stroke="#D79EED" stroke-width="2" stroke-linejoin="round"/>
                    <!-- Orange area (Series B — middle layer) -->
                    <path d="M80,140 L170,128 L260,108 L350,95 L440,80 L530,70 L620,55 L620,155 L530,118 L440,125 L350,133 L260,140 L170,148 L80,155 Z" fill="#FFE4D0" opacity="0.85"/>
